{
  "name": "@pinkpixel/memi",
  "version": "1.0.0",
  "description": "Local-first memory for AI agents. SQLite, hybrid search, MCP server, and a small local UI.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Pink Pixel <admin@pinkpixel.dev> (https://pinkpixel.dev)",
  "homepage": "https://pinkpixel.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinkpixel-dev/memi.git"
  },
  "bin": {
    "memi": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "ui",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm run build",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "memory",
    "agents",
    "sqlite",
    "embeddings",
    "ollama",
    "openai"
  ],
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/pinkpixel-dev/memi/issues"
  }
